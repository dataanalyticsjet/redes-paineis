# Template only. Replace DOMINIO_PRODUCAO, FRONTEND_PORT and BACKEND_PORT after
# choosing the approved domain and checking both ports on the Ubuntu server.
# Enable only after the FastAPI migration plan covers every current /api route.

log_format redes_paineis_safe '$remote_addr - [$time_local] "$request_method $uri HTTP/$server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    server_name DOMINIO_PRODUCAO;

    access_log /var/log/nginx/redes-paineis.access.log redes_paineis_safe;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name DOMINIO_PRODUCAO;

    ssl_certificate /etc/letsencrypt/live/DOMINIO_PRODUCAO/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMINIO_PRODUCAO/privkey.pem;
    server_tokens off;
    client_max_body_size 64m;
    access_log /var/log/nginx/redes-paineis.access.log redes_paineis_safe;

    # Keep the URI prefix and public Host so FastAPI can validate the configured
    # HTTPS callback. Both upstream services bind only to loopback.
    location /api/ {
        proxy_pass http://127.0.0.1:BACKEND_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://127.0.0.1:FRONTEND_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Local Vite frontend. The FastAPI service runs separately.
FRONTEND_PORT=3001
# Direct API origin for the browser. Leave empty when using same-origin proxying.
VITE_API_BASE_URL=http://127.0.0.1:8001
# Used by the Vite development proxy when VITE_API_BASE_URL is empty.
FASTAPI_DEV_TARGET=http://127.0.0.1:8001

# Nitro Node.js server output.
NITRO_PRESET=node-server

# Local dashboard fixtures only; set false to use the configured API data.
VITE_DASHBOARD_DEMO_MODE=false

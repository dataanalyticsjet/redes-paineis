# Upload account used by the workbook upload API.
UPLOAD_USERNAME=
UPLOAD_PASSWORD=

# JSON array of dashboard viewer accounts. Keep empty until configured.
VIEWER_ACCOUNTS_JSON=[]

# Optional account limited to one base.
BASE_VIEWER_USERNAME=
BASE_VIEWER_PASSWORD=
BASE_VIEWER_BASE=

# Local Feishu OAuth. Register this exact callback URL in the Feishu app settings.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# Use a random secret of at least 32 characters; store it only in local secrets/Worker secrets.
FEISHU_SESSION_SECRET=

# Explicit Feishu authorization list. Only matching email + tenant_key entries
# can sign in. role=regional requires region and/or base; role=matrix is full dashboard access.
FEISHU_VIEWER_ACCOUNTS_JSON=[]

# Local development only; demo mode never runs in production builds.
VITE_DASHBOARD_DEMO_MODE=false

APP_ENV=development
DATA_SOURCES_ENABLED=false

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

FRONTEND_BASE_URL=http://127.0.0.1:3001
DATA_DIRECTORY=
UPLOAD_USERNAME=
UPLOAD_PASSWORD=

FEISHU_OAUTH_ENABLED=true
FEISHU_OAUTH_APP_ID=
FEISHU_OAUTH_APP_SECRET=
FEISHU_OAUTH_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
FEISHU_OAUTH_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/auth/feishu/callback
FEISHU_SESSION_SECRET=
FEISHU_VIEWER_ACCOUNTS_JSON=[]
ALLOWED_CORPORATE_DOMAINS=jtexpress.com.br

# Production overrides: put these in the server-side environment file only.
# Choose the domain and persistent directory with the deployment owner.
# APP_ENV=production
# DATA_DIRECTORY=/home/ubuntu/redes-paineis-data
# FRONTEND_BASE_URL=https://DOMINIO_PRODUCAO
# FEISHU_OAUTH_REDIRECT_URI=https://DOMINIO_PRODUCAO/api/auth/feishu/callback
# Register that callback manually in the Feishu application.
# Keep the production API at one worker while sessions and OAuth state are in memory.
